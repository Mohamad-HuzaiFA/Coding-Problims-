        // return res;


//Below is in place parity sorting
        int i=0;
        int j=nums.size() - 1;

        while(i<j)
        {
            if(nums[i] % 2 != 0)
            {
                if(nums[j] % 2 != 0)
                {
                    j--;
                    continue;
                }
                int temp = nums[i];
                nums[i] = nums[j];
                nums[j] = temp;
            }
        i++;
        }

        return nums;
    }
